# Server-only Neon connection string. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# A strong, unique LTPC moderator password (at least 16 characters).
ADMIN_PASSWORD=
# Independent cryptographically random secret, at least 32 characters.
ADMIN_SESSION_SECRET=
# Optional: defaults to 20 created cards/hour/network identity.
CARD_RATE_LIMIT=20
# Automated letter review. Set false to send everything to manual review.
AUTO_MODERATION_ENABLED=true
# Server-only Gemini API key from Google AI Studio. Never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: a Gemini model ID supporting structured output.
MODERATION_MODEL=gemini-3.8-flash
